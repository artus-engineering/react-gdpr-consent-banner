{
    "name": "@artus-engineering/react-gdpr-cookie-consent",
    "version": "2.0.2",
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
    "type": "module",
    "description": "A simple and customizable GDPR cookie consent component for React.",
    "main": "dist/cjs/index.cjs",
    "module": "dist/esm/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.cjs"
        },
        "./headless": {
            "types": "./dist/headless.d.ts",
            "import": "./dist/esm/headless.js",
            "require": "./dist/cjs/headless.cjs"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": ["dist", "README.md", "LICENSE"],
    "scripts": {
        "dev": "concurrently \"rollup -c --watch\" \"pnpm --dir example run dev\"",
        "dev:lib": "rollup -c --watch",
        "dev:example": "pnpm --dir example run dev",
        "build": "rollup -c --bundleConfigAsCjs",
        "test": "pnpm run test:unit && pnpm run test:import && pnpm run build-storybook && pnpm run test:visual",
        "test:unit": "jest --coverage --watchAll=false",
        "test:unit:watch": "jest --coverage --watch",
        "test:import": "node tests/import/test-import.js",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test:visual": "playwright test",
        "test:visual:update": "playwright test --update-snapshots",
        "prepare": "node -e \"const on=v=>!!v&&v!=='0'&&v!=='false';if(on(process.env.CI)&&!on(process.env.LEFTHOOK))process.exit(0);try{require('child_process').execSync('lefthook install --reset-hooks-path',{stdio:'inherit'})}catch{}\"",
        "format": "biome format --write .",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "biome:migrate": "biome migrate --write",
        "build:wordpress": "node wordpress/react-gdpr-cookie-consent/esbuild.config.mjs"
    },
    "keywords": ["gdpr", "cookie", "consent", "react", "privacy", "compliance"],
    "author": "Artus Engineering GmbH",
    "homepage": "https://react-gdpr-consent-banner.artus-engineering.de",
    "license": "PolyForm-Noncommercial-1.0.0",
    "peerDependencies": {
        "react": ">=19.0.0",
        "react-dom": ">=19.0.0"
    },
    "devDependencies": {
        "@babel/preset-env": "7.29.7",
        "@babel/preset-react": "7.29.7",
        "@babel/preset-typescript": "7.29.7",
        "@biomejs/biome": "2.6.7",
        "@chromatic-com/storybook": "5.6.0",
        "@jest/test-sequencer": "30.5.2",
        "@playwright/test": "1.65.0",
        "@rollup/plugin-commonjs": "29.0.3",
        "@rollup/plugin-terser": "1.0.2",
        "@rollup/plugin-typescript": "12.3.1",
        "@storybook/addon-docs": "10.6.7",
        "@storybook/addon-links": "10.6.7",
        "@storybook/react": "10.6.7",
        "@storybook/react-vite": "10.6.7",
        "@tailwindcss/postcss": "4.3.5",
        "@tailwindcss/vite": "4.3.5",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "^14.6.10",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "archiver": "^8.0.0",
        "autoprefixer": "10.6.2",
        "babel-jest": "30.5.2",
        "baseline-browser-mapping": "2.11.6",
        "concurrently": "^10.0.7",
        "diff-sequences": "^29.6.3",
        "esbuild": "0.28.2",
        "http-server": "14.1.1",
        "jest": "30.5.2",
        "jest-environment-jsdom": "30.5.2",
        "jest-get-type": "^29.6.3",
        "lefthook": "^2.2.2",
        "postcss": "8.5.32",
        "rollup": "4.68.2",
        "rollup-plugin-analyzer": "4.0.0",
        "rollup-plugin-dts": "6.5.1",
        "rollup-plugin-peer-deps-external": "2.2.4",
        "rollup-plugin-postcss": "4.0.2",
        "storybook": "10.6.7",
        "tailwindcss": "4.3.5",
        "tslib": "^2.9.1",
        "typescript": "6.0.3",
        "vite": "8.3.8"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "setupFilesAfterEnv": ["<rootDir>/src/setupTests.ts"],
        "watchman": false,
        "testPathIgnorePatterns": ["/node_modules/", "<rootDir>/tests/", "<rootDir>/dist/"],
        "collectCoverageFrom": [
            "src/**/*.{ts,tsx}",
            "!src/**/*.d.ts",
            "!src/**/*.test.{ts,tsx}",
            "!src/**/*.stories.{ts,tsx}",
            "!src/setupTests.ts",
            "!src/**/index.ts",
            "!src/test-utils/**"
        ],
        "coverageDirectory": "coverage",
        "coverageProvider": "v8",
        "coverageReporters": ["text", "text-summary", "lcov", "html"]
    },
    "babel": {
        "presets": [
            "@babel/preset-env",
            "@babel/preset-typescript",
            [
                "@babel/preset-react",
                {
                    "runtime": "automatic"
                }
            ]
        ]
    },
    "browserslist": {
        "production": [">0.2%", "not dead", "not op_mini all"],
        "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
    },
    "bugs": {
        "url": "https://github.com/artus-engineering/react-gdpr-consent-banner/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/artus-engineering/react-gdpr-consent-banner.git"
    }
}
