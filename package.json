{
    "name": "@artus_engineering/react-gdpr-cookie-consent",
    "version": "0.1.11",
    "type": "module",
    "description": "A simple and customizable GDPR cookie consent component for React.",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "concurrently \"rollup -c --watch\" \"cd example && npm run dev\"",
        "dev:lib": "rollup -c --watch",
        "dev:example": "cd example && npm run dev",
        "build": "rollup -c --bundleConfigAsCjs",
        "test": "jest --watchAll=false",
        "test:watch": "jest --watch",
        "test:consent-hooks": "jest consentHooks.test.ts",
        "test:coverage": "jest --coverage --watchAll=false",
        "test:import": "node scripts/test-import.js",
        "test:all": "pnpm run test && pnpm run test:import",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prepare": "husky",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
        "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
        "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
        "publish:npmjs": "node scripts/publish.js patch npmjs",
        "publish:github": "node scripts/publish.js patch github",
        "publish:dry": "node scripts/publish.js patch npmjs --dry-run",
        "version:patch": "node scripts/publish.js patch npmjs --dry-run",
        "version:minor": "node scripts/publish.js minor npmjs --dry-run",
        "version:major": "node scripts/publish.js major npmjs --dry-run"
    },
    "keywords": [
        "gdpr",
        "cookie",
        "consent",
        "react",
        "privacy",
        "compliance"
    ],
    "author": "Yannic Schröer <yannic@schroeer.tech>",
    "license": "ISC",
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@babel/preset-env": "7.28.5",
        "@babel/preset-react": "7.28.5",
        "@babel/preset-typescript": "7.28.5",
        "@chromatic-com/storybook": "4.1.3",
        "@eslint/js": "^9.39.1",
        "@jest/test-sequencer": "30.2.0",
        "@rollup/plugin-commonjs": "29.0.0",
        "@rollup/plugin-terser": "0.4.4",
        "@rollup/plugin-typescript": "12.3.0",
        "@storybook/addon-essentials": "8.6.14",
        "@storybook/addon-interactions": "8.6.14",
        "@storybook/addon-links": "10.1.4",
        "@storybook/addon-onboarding": "10.1.4",
        "@storybook/blocks": "8.6.14",
        "@storybook/react": "10.1.4",
        "@storybook/react-vite": "10.1.4",
        "@tailwindcss/postcss": "4.1.17",
        "@tailwindcss/vite": "^4.1.17",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "30.0.0",
        "@types/node": "24.10.1",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.18.2",
        "@typescript-eslint/parser": "^8.18.2",
        "autoprefixer": "10.4.22",
        "babel-jest": "30.2.0",
        "concurrently": "^9.2.1",
        "diff-sequences": "^29.6.3",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest": "^29.2.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^16.5.0",
        "husky": "9.1.7",
        "jest": "30.2.0",
        "jest-environment-jsdom": "30.2.0",
        "jest-get-type": "^29.6.3",
        "postcss": "8.5.6",
        "prettier": "^3.4.2",
        "rollup": "4.53.3",
        "rollup-plugin-analyzer": "4.0.0",
        "rollup-plugin-dts": "6.3.0",
        "rollup-plugin-peer-deps-external": "2.2.4",
        "rollup-plugin-postcss": "4.0.2",
        "storybook": "10.1.4",
        "tailwindcss": "4.1.17",
        "tslib": "^2.8.1",
        "typescript": "5.9.3"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "setupFilesAfterEnv": [
            "<rootDir>/src/setupTests.ts"
        ]
    },
    "babel": {
        "presets": [
            "@babel/preset-env",
            "@babel/preset-typescript",
            [
                "@babel/preset-react",
                {
                    "runtime": "automatic"
                }
            ]
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/artus-engineering/react-gdpr-consent-banner.git"
    }
}
