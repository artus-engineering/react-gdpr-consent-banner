{
    "name": "@artus_engineering/react-gdpr-cookie-consent",
    "version": "0.1.11",
    "packageManager": "pnpm@10.33.0",
    "type": "module",
    "description": "A simple and customizable GDPR cookie consent component for React.",
    "main": "dist/cjs/index.cjs",
    "module": "dist/esm/index.js",
    "types": "dist/index.d.ts",
    "files": ["dist", "README.md", "LICENSE"],
    "scripts": {
        "dev": "concurrently \"rollup -c --watch\" \"pnpm --dir example run dev\"",
        "dev:lib": "rollup -c --watch",
        "dev:example": "pnpm --dir example run dev",
        "build": "rollup -c --bundleConfigAsCjs",
        "test": "jest --coverage --watchAll=false",
        "test:watch": "jest --coverage --watch",
        "test:import": "node scripts/test-import.js",
        "test:all": "pnpm run test && pnpm run test:import",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prepare": "husky",
        "format": "biome format --write .",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "publish:npmjs": "node scripts/publish.js patch npmjs",
        "publish:github": "node scripts/publish.js patch github",
        "publish:dry": "node scripts/publish.js patch npmjs --dry-run",
        "version:patch": "node scripts/publish.js patch npmjs --dry-run",
        "version:minor": "node scripts/publish.js minor npmjs --dry-run",
        "version:major": "node scripts/publish.js major npmjs --dry-run"
    },
    "keywords": ["gdpr", "cookie", "consent", "react", "privacy", "compliance"],
    "author": "Yannic Schröer <yannic@schroeer.tech>",
    "license": "ISC",
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@babel/preset-env": "7.29.2",
        "@babel/preset-react": "7.28.5",
        "@babel/preset-typescript": "7.28.5",
        "@biomejs/biome": "2.4.12",
        "@chromatic-com/storybook": "5.1.2",
        "@jest/test-sequencer": "30.3.0",
        "@rollup/plugin-commonjs": "29.0.2",
        "@rollup/plugin-terser": "1.0.0",
        "@rollup/plugin-typescript": "12.3.0",
        "@storybook/addon-docs": "10.3.5",
        "@storybook/addon-links": "10.3.5",
        "@storybook/addon-onboarding": "10.3.5",
        "@storybook/react": "10.3.5",
        "@storybook/react-vite": "10.3.5",
        "@tailwindcss/postcss": "4.2.3",
        "@tailwindcss/vite": "4.2.3",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "30.0.0",
        "@types/node": "25.6.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "autoprefixer": "10.5.0",
        "babel-jest": "30.3.0",
        "baseline-browser-mapping": "^2.10.20",
        "concurrently": "^9.2.1",
        "diff-sequences": "^29.6.3",
        "esbuild": "0.28.0",
        "husky": "9.1.7",
        "jest": "30.3.0",
        "jest-environment-jsdom": "30.3.0",
        "jest-get-type": "^29.6.3",
        "postcss": "8.5.10",
        "rollup": "4.60.2",
        "rollup-plugin-analyzer": "4.0.0",
        "rollup-plugin-dts": "6.4.1",
        "rollup-plugin-peer-deps-external": "2.2.4",
        "rollup-plugin-postcss": "4.0.2",
        "storybook": "10.3.5",
        "tailwindcss": "4.2.3",
        "tslib": "^2.8.1",
        "typescript": "6.0.3",
        "vite": "8.0.9"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "setupFilesAfterEnv": ["<rootDir>/src/setupTests.ts"],
        "collectCoverageFrom": [
            "src/**/*.{ts,tsx}",
            "!src/**/*.d.ts",
            "!src/**/*.test.{ts,tsx}",
            "!src/**/*.stories.{ts,tsx}",
            "!src/setupTests.ts",
            "!src/**/index.ts"
        ],
        "coverageDirectory": "coverage",
        "coverageProvider": "v8",
        "coverageReporters": ["text", "text-summary", "lcov", "html"]
    },
    "babel": {
        "presets": [
            "@babel/preset-env",
            "@babel/preset-typescript",
            [
                "@babel/preset-react",
                {
                    "runtime": "automatic"
                }
            ]
        ]
    },
    "browserslist": {
        "production": [">0.2%", "not dead", "not op_mini all"],
        "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/artus-engineering/react-gdpr-consent-banner.git"
    },
    "pnpm": {
        "overrides": {
            "yaml": "^2.8.3"
        }
    }
}
