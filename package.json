{
    "name": "@artus-engineering/react-gdpr-cookie-consent",
    "version": "0.1.5-beta",
    "description": "A simple and customizable GDPR cookie consent component for React.",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/index.d.ts",
    "files": ["dist", "README.md", "LICENSE"],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "dev": "rollup -c --watch",
        "build": "rollup -c --bundleConfigAsCjs",
        "test": "jest --watchAll=false",
        "test:watch": "jest --watch",
        "test:consent-hooks": "jest consentHooks.test.ts",
        "test:coverage": "jest --coverage --watchAll=false",
        "test:import": "node scripts/test-import.js",
        "test:all": "pnpm run test && pnpm run test:import",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prepare": "husky",
        "format": "biome format --write --error-on-warnings",
        "lint": "biome lint .",
        "lint:fix": "biome check --apply ."
    },
    "keywords": ["gdpr", "cookie", "consent", "react", "privacy", "compliance"],
    "author": "Yannic Schröer <yannic@schroeer.tech>",
    "license": "ISC",
    "peerDependencies": {
        "@headlessui/react": "^2.2.7",
        "react": "^19",
        "react-dom": "^19"
    },
    "devDependencies": {
        "@babel/preset-env": "7.28.3",
        "@babel/preset-react": "7.27.1",
        "@babel/preset-typescript": "7.27.1",
        "@biomejs/biome": "2.2.2",
        "@chromatic-com/storybook": "4.1.1",
        "@rollup/plugin-commonjs": "28.0.6",
        "@rollup/plugin-terser": "0.4.4",
        "@rollup/plugin-typescript": "12.1.4",
        "@storybook/addon-essentials": "8.6.14",
        "@storybook/addon-interactions": "8.6.14",
        "@storybook/addon-links": "9.1.3",
        "@storybook/addon-onboarding": "9.1.3",
        "@storybook/blocks": "8.6.14",
        "@storybook/preset-create-react-app": "9.1.3",
        "@storybook/react": "9.1.3",
        "@storybook/react-vite": "9.1.3",
        "@storybook/react-webpack5": "9.1.3",
        "@storybook/test": "8.6.14",
        "@tailwindcss/postcss": "4.1.12",
        "@tailwindcss/vite": "^4.1.12",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "30.0.0",
        "@types/node": "^24.3.0",
        "@types/pg": "^8.15.5",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "autoprefixer": "10.4.21",
        "babel-jest": "30.1.2",
        "husky": "9.1.7",
        "jest": "30.1.2",
        "jest-environment-jsdom": "30.1.2",
        "pg": "^8.16.3",
        "postcss": "8.5.6",
        "prop-types": "15.8.1",
        "rollup": "4.50.0",
        "rollup-plugin-analyzer": "4.0.0",
        "rollup-plugin-dts": "6.2.3",
        "rollup-plugin-peer-deps-external": "2.2.4",
        "rollup-plugin-postcss": "4.0.2",
        "storybook": "9.1.3",
        "tailwindcss": "4.1.12",
        "typescript": "5.9.2"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "setupFilesAfterEnv": ["<rootDir>/src/setupTests.ts"]
    },
    "babel": {
        "presets": [
            "@babel/preset-env",
            "@babel/preset-typescript",
            [
                "@babel/preset-react",
                {
                    "runtime": "automatic"
                }
            ]
        ]
    },
    "browserslist": {
        "production": [">0.2%", "not dead", "not op_mini all"],
        "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/artus-engineering/react-gdpr-consent-banner.git"
    }
}
